# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nextgen_class?sslmode=require"

# Authentication Secrets
AUTH_SECRET="your-256-bit-secret-key-here-for-jwt-signing"
AUTH_SESSION_EXPIRES_IN="7d"

# Storage Configuration (S3-Compatible Object Storage)
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="nextgen-class-documents"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"

# Transactional Email Provider Configuration
EMAIL_PROVIDER="smtp" # Options: smtp, sendgrid, resend, mock
EMAIL_FROM="admissions@nextgenacademy.org"
EMAIL_SMTP_HOST="smtp.mailtrap.io"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="smtp-username"
EMAIL_SMTP_PASSWORD="smtp-password"

# Application URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api"

# AI / Gemini API
GEMINI_API_KEY=""

