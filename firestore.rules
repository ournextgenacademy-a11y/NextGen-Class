rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isManagerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ournextgenacademy@gmail.com' ||
        request.auth.token.email == 'admin@nextgenacademy.org' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ================= USERS COLLECTION =================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || isManagerOrAdmin());
      allow delete: if isManagerOrAdmin();
    }

    // ================= PROGRAMMES COLLECTION =================
    match /programmes/{programmeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Also support 'programs' alias if used
    match /programs/{programId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ================= COHORTS COLLECTION =================
    match /cohorts/{cohortId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ================= APPLICATIONS COLLECTION =================
    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ================= FORMS COLLECTION =================
    match /forms/{formId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ================= ASSESSMENTS COLLECTION =================
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ================= ASSESSMENT ATTEMPTS / SUBMISSIONS =================
    match /assessmentAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isManagerOrAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isManagerOrAdmin();
    }

    // ================= NOTIFICATIONS & MESSAGES =================
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ================= AUDIT LOGS =================
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // ================= ADMINS =================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isManagerOrAdmin();
    }

    // ================= CONNECTION TEST =================
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
